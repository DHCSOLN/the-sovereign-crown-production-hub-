def clean_line(line: str) -> str:
    line = line.replace("\ufeff", "").strip()
    line = re.sub(r"^[🎬📋👥💰🔍🔒📁📰📱📸]+\s*", "", line)
    line = re.sub(r"(?<!https)(?<!http)://stateoflocnation\.com", WEBSITE, line)
    line = line.replace("httpshttps://", "https://")
    line = re.sub(r"^\*\s*\*\s*", "", line)
    line = re.sub(r"^\*\s+", "", line)
    line = re.sub(r"_{6,}", "", line)
    return line.strip()


def remove_assistant_prompt(text: str) -> str:
    """Remove conversational drafting prompts that are not portfolio content."""
    patterns = (
        r"\bWould you like me\b",
        r"\bwould you like me\b",
        r"\bLet me know if you would like me\b",
        r"\bNow that the .*? let me know\b",
        r"\bPlease confirm if you are ready\b",
        r"\bPlease let me know if you would like\b",
    )
    cut = len(text)
    for pattern in patterns:
        match = re.search(pattern, text, flags=re.I)
        if match:
            cut = min(cut, match.start())
    return text[:cut].strip()


def split_sections(raw: str):
    lines = raw.replace("\r\n", "\n").split("\n")
    sections = []
    title = "Source opening material"
    body = []
    for original in lines:
        line = clean_line(original)
        if re.match(r"^(SECTION\s+\d+|PART\s+\d+|PROJECT PROFILE|PROJECT REFERENCE|THE SOVEREIGN CROWN:)", line, re.I):
            if any(x.strip() for x in body):
                sections.append((title, body))
            title = line.title() if line.isupper() else line
            body = []
        else:
            body.append(line)
    if any(x.strip() for x in body):
        sections.append((title, body))
    return sections


def normalized_section(title, body) -> str:
    text = title + "\n" + "\n".join(body)
    return re.sub(r"\W+", "", text).lower()


def add_archive(doc: Document, raw: str) -> None:
    doc.add_page_break()
    doc.add_heading("Production and creative archive", level=1)
    doc.add_paragraph(
        "The following appendix preserves the substantive creative and production material from the supplied master "
        "text while removing exact repeated sections, separator lines, emoji markers, and conversational prompts. "
        "Template agreements and legal language remain working drafts and require professional review before use."
    )
    seen = set()
    kept = 0
    for title, body in split_sections(raw):
        normalized = normalized_section(title, body)
        digest = hashlib.sha256(normalized.encode("utf-8")).hexdigest()
        if digest in seen or len(normalized) < 80:
            continue
        seen.add(digest)
        kept += 1
        doc.add_heading(title[:180], level=2)
        paragraph_buffer = []
        for line in body:
            if not line:
                if paragraph_buffer:
                    paragraph = remove_assistant_prompt(" ".join(paragraph_buffer))
                    if paragraph:
                        doc.add_paragraph(paragraph)
                    paragraph_buffer = []
                continue
            if re.match(r"^(ACT|SCENE|EPISODE|INT\.|EXT\.|FADE|TITLE:|LOGLINE|SYNOPSIS|OBJECTIVE|BUDGET|TOTAL|MEDIA CONTACT)", line, re.I) and len(line) < 150:
                if paragraph_buffer:
                    paragraph = remove_assistant_prompt(" ".join(paragraph_buffer))
                    if paragraph:
                        doc.add_paragraph(paragraph)
                    paragraph_buffer = []
                p = doc.add_paragraph()
                r = p.add_run(line)
                set_run_font(r, size=9.5, bold=True)
            elif re.match(r"^[-•]\s+", line) or re.match(r"^\d+[.)]\s+", line):
                if paragraph_buffer:
                    paragraph = remove_assistant_prompt(" ".join(paragraph_buffer))
                    if paragraph:
                        doc.add_paragraph(paragraph)
                    paragraph_buffer = []
                doc.add_paragraph(re.sub(r"^[-•]\s+", "", line), style="List Bullet")
            else:
                paragraph_buffer.append(line)
        if paragraph_buffer:
            paragraph = remove_assistant_prompt(" ".join(paragraph_buffer))
            if paragraph:
                doc.add_paragraph(paragraph)
    doc.add_paragraph(f"Archive assembly note: {kept} non-empty source sections were retained after exact de-duplication.")


def finalize_footer(doc: Document) -> None:
    for section in doc.sections:
        footer = section.footer
        p = footer.paragraphs[0]
        p.alignment = WD_ALIGN_PARAGRAPH.CENTER
        if not p.text:
            r = p.add_run("Property of Clement Dynasty Dynasty Trust | Presented by State of Loc Nation GPBC")
            set_run_font(r, size=8, color="666666")
        add_page_number(p)


def build(source: Path, output: Path) -> None:
    raw = source.read_text(encoding="utf-8-sig", errors="replace")
    doc = Document()
    configure_document(doc)
    add_cover(doc)
    add_intro(doc)
    add_application_answers(doc)
    add_schedule(doc)
    add_budget(doc)
    add_work_sample(doc)
    add_video_index(doc)
    add_archive(doc, raw)
    finalize_footer(doc)
    output.parent.mkdir(parents=True, exist_ok=True)
    doc.save(output)


if __name__ == "__main__":
    if len(sys.argv) != 3:
        raise SystemExit("Usage: python build_bpm_application.py SOURCE.txt OUTPUT.docx")
    build(Path(sys.argv[1]), Path(sys.argv[2]))
