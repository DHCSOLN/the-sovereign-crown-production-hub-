#!/usr/bin/env python3
"Build a clean Word edition of The Sovereign Crown BPM application.

Usage:
  python build_bpm_application.py SOURCE.txt OUTPUT.docx

The script creates a submission-ready front section, a TikTok evidence index,
and a cleaned, de-duplicated production appendix from the supplied master text.
It does not invent URLs, awards, personnel, registrations, or verification.
"""

from __future__ import annotations

